{
  "$schema": "https://opencode.ai/config.schema.json",
  "permissions": [
    {
      "action": "shell",
      "resource": "npm test*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "npm run build*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "npm run check:rust*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "npm run test:rust*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "cargo test --manifest-path src-tauri/Cargo.toml*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "cargo fmt *--check*",
      "effect": "allow"
    }
  ]
}
