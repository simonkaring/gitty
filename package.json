{
  "name": "gitty",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node --test scripts/e2e/environment.test.mjs && playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "dev:e2e": "node scripts/e2e/harness.mjs",
    "package:cli": "node scripts/package-cli.mjs",
    "package:cli:test": "node --test scripts/package-cli.test.mjs",
    "build:cli": "cargo build --release --manifest-path crates/gitty-cli/Cargo.toml --bin gitty-cli",
    "tauri": "tauri",
    "prepare:gcm": "node scripts/prepare-gcm.mjs",
    "desktop": "npm run prepare:gcm && node --env-file-if-exists=.env node_modules/@tauri-apps/cli/tauri.js dev",
    "desktop:build": "node --env-file-if-exists=.env node_modules/@tauri-apps/cli/tauri.js build",
    "check:rust": "cargo check --workspace",
    "test:rust": "cargo test --workspace",
    "check:headless": "cargo check -p gitty-core -p gitty-cli",
    "test:headless": "cargo test -p gitty-core -p gitty-cli",
    "bench:fixtures": "node scripts/bench/fixtures.mjs",
    "bench:backend": "node scripts/bench/backend.mjs",
    "bench:compare": "node scripts/bench/compare.mjs",
    "bench:apps": "node scripts/bench/apps.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.2.6",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^30.1.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  }
}
